# ==============================================================================
# Scalezix — Client Onboarding Document Checker Environment Configuration
# ==============================================================================

# ─── Django Backend Configuration ─────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# ─── Database Configuration ───────────────────────────────────────────────────
# In production on Vercel, connect to a managed PostgreSQL database (Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Leave DATABASE_URL blank to fall back to SQLite for local development & isolated testing.
# Connection options:
# DB_CONN_MAX_AGE=0
# DB_CONNECT_TIMEOUT=10
# DB_SSL_REQUIRE=True

# ─── CORS & CSRF Security ─────────────────────────────────────────────────────
# Deployed frontend origin (comma-separated if multiple):
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.vercel.app

# ─── AI Service (OpenAI-compatible) ──────────────────────────────────────────
# Optional: Leave blank to use 100% deterministic rule-based gap analysis
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Upload Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── React Frontend Configuration ────────────────────────────────────────────
# Deployed Django backend API URL (used by Vite in production):
VITE_API_BASE_URL=https://your-backend.vercel.app
