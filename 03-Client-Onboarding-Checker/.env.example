# ==============================================================================
# Scalezix — Client Onboarding Document Checker Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=scalezix-insecure-production-secret-key-change-in-prod-xyz789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (SQLite default; MySQL optional)
USE_MYSQL=False
DB_NAME=scalezix_onboarding
DB_USER=scalezix_user
DB_PASSWORD=your_secure_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Intelligent Audit Integration (OpenAI-compatible)
# Leave blank to use 100% deterministic rule-based gap analysis
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
MAX_UPLOAD_SIZE_MB=10

