# ==============================================================================
# Scalezix — Backend Environment Configuration (.env.example)
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Database (PostgreSQL recommended for production, e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL=
# Leave blank to use SQLite for local dev
# DB_CONN_MAX_AGE=0
# DB_CONNECT_TIMEOUT=10
# DB_SSL_REQUIRE=True

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.vercel.app

# AI Integration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

